{
  "name": "taller-mapas-elyria",
  "version": "1.0.0",
  "description": "Editor de mapas FE8 para Fisuras de Elyria",
  "main": "main.js",
  "scripts": {
    "preparar": "node preparar.js",
    "start": "npm run preparar && electron .",
    "build": "npm run preparar && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "elyria.taller.mapas",
    "productName": "Taller de Mapas Elyria",
    "files": ["main.js", "editor.html", "catalogo.js", "datos_fe8.js", "mapas_estimados.js", "imagenes/**"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "signAndEditExecutable": false }
  }
}
